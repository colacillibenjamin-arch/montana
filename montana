local EnabledSpin = false
local SpinAngle = 0
local SPIN_SPEED = 0.65
local SpinConn = nil
local function forceSpinOrientation()
 if not EnabledSpin then return end
 local char = Client.Character
 if not char then return end
 local hrp = char:FindFirstChild("HumanoidRootPart")
 local hum = char:FindFirstChildOfClass("Humanoid")
 if not hrp or not hrp.Parent then return end
 if hum then
  hum.AutoRotate = false
 end
 local pos = hrp.Position
 local vel = hrp.AssemblyLinearVelocity
 hrp.CFrame = CFrame.new(pos) * CFrame.Angles(0, SpinAngle, 0)
 hrp.AssemblyLinearVelocity = vel
 hrp.AssemblyAngularVelocity = Vector3.zero
end
local function tickSpin(dt)
 if not EnabledSpin then return end
 dt = dt or 0.016
 SpinAngle = SpinAngle + (SPIN_SPEED * 60 * dt)
 if SpinAngle > 6.283185307179586 then
  SpinAngle = SpinAngle % 6.283185307179586
 end
 forceSpinOrientation()
 task.defer(forceSpinOrientation)
end
local function stopSpin()
 EnabledSpin = false
 SpinAngle = 0
 pcall(function() RunService:UnbindFromRenderStep("EsSpin") end)
 pcall(function() RunService:UnbindFromRenderStep("EsSpinLate") end)
 pcall(function() RunService:UnbindFromRenderStep("EsSpinCam") end)
 if SpinConn then
  pcall(function() SpinConn:Disconnect() end)
  SpinConn = nil
 end
 local char = Client.Character
 local hum = char and char:FindFirstChildOfClass("Humanoid")
 if hum then
  pcall(function() hum.AutoRotate = true end)
 end
end
local function startSpin()
 stopSpin()
 EnabledSpin = true
 pcall(function()
  RunService:BindToRenderStep("EsSpin", Enum.RenderPriority.Character.Value + 50, function(dt)
   tickSpin(dt)
  end)
 end)
 pcall(function()
  RunService:BindToRenderStep("EsSpinCam", Enum.RenderPriority.Camera.Value + 50, forceSpinOrientation)
 end)
 pcall(function()
  RunService:BindToRenderStep("EsSpinLate", Enum.RenderPriority.Last.Value + 200, forceSpinOrientation)
 end)
 local _lastSpinHb = 0
 SpinConn = RunService.Heartbeat:Connect(function(dt)
  if not EnabledSpin then return end
  local now = tick()
  if now - _lastSpinHb < 0.016 then return end
  _lastSpinHb = now
  tickSpin(dt)
  task.defer(forceSpinOrientation)
 end)
end
